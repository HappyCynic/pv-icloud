# Copy to devcontainer.env (gitignored; done automatically on first start) and fill in.
# Only needed for live runs against iCloud; tests use fake IMAP/CalDAV servers.
# Never commit real values.
#
# One block per iCloud account. <ID> is the account id from config/pv-icloud.yaml,
# upper-cased (see docs/adr/0003-multi-account.md).
#   PV_ICLOUD_<ID>_ICLOUD_USER       Apple ID email
#   PV_ICLOUD_<ID>_APP_PASSWORD      app-specific password (appleid.apple.com)
# MCP bearer tokens are not stored here: config holds their SHA-256 hashes,
# and the plaintext token lives only with the client.

PV_ICLOUD_ME_ICLOUD_USER=
PV_ICLOUD_ME_APP_PASSWORD=
