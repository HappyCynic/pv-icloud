# pv-icloud secrets TEMPLATE. Copy to pv-icloud.env (gitignored) and fill in.
# One block per account in config/pv-icloud.yaml; <ID> is the account id upper-cased.
#   PV_ICLOUD_<ID>_ICLOUD_USER    Apple ID email
#   PV_ICLOUD_<ID>_APP_PASSWORD   app-specific password (appleid.apple.com →
#                                 Sign-In and Security → App-Specific Passwords)
# Bearer tokens are NOT stored here: the config holds their SHA-256 hashes.

PV_ICLOUD_ME_ICLOUD_USER=
PV_ICLOUD_ME_APP_PASSWORD=
